<div class="max-w-4xl mx-auto">
  <h2 class="text-2xl font-semibold text-space-star mb-6">Administer Star System</h2>
  
  <% if @star_system.errors.any? %>
    <div class="bg-red-900/30 border border-red-800 rounded-lg p-4 mb-6">
      <h3 class="text-red-400 font-medium mb-2">The following errors occurred:</h3>
      <ul class="list-disc list-inside text-red-300">
        <% @star_system.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  
  <!-- Star system details -->
  <div class="bg-space-blue/30 border border-space-purple/30 rounded-lg p-6 shadow-lg mb-6">
    <%= form_with(model: @star_system, local: true, class: "space-y-6") do |form| %>
      <div>
        <%= form.label :name, class: "block text-gray-300 mb-1" %>
        <%= form.text_field :name, class: "w-full bg-space-blue/30 border border-space-purple/50 rounded-lg p-2 text-white" %>
      </div>
      
      <div class="flex justify-between">
        <%= form.submit "Update Star System", class: "bg-space-nebula hover:bg-space-purple text-white font-medium py-2 px-4 rounded-lg transition" %>
        <%= link_to "Back to Dashboard", dashboard_path, class: "bg-transparent border border-space-purple/50 text-space-highlight hover:bg-space-blue/30 py-2 px-4 rounded-lg transition" %>
      </div>
    <% end %>
  </div>
  
  <!-- Resource display -->
  <div class="bg-space-blue/30 border border-space-purple/30 rounded-lg p-4 shadow-lg mb-6">
    <h3 class="text-xl font-semibold text-space-accent mb-3">Empire Resources</h3>
    <div class="grid grid-cols-4 gap-4">
      <div>
        <span class="text-gray-400">Credits:</span>
        <span class="text-space-highlight ml-2"><%= current_user.empire.credits %></span>
      </div>
      <div>
        <span class="text-gray-400">Minerals:</span>
        <span class="text-space-highlight ml-2"><%= current_user.empire.minerals %></span>
      </div>
      <div>
        <span class="text-gray-400">Energy:</span>
        <span class="text-space-highlight ml-2"><%= current_user.empire.energy %></span>
      </div>
      <div>
        <span class="text-gray-400">Food:</span>
        <span class="text-space-highlight ml-2"><%= current_user.empire.food %></span>
      </div>
    </div>
  </div>
  
  <!-- Buildings section -->
  <div class="bg-space-blue/30 border border-space-purple/30 rounded-lg p-6 shadow-lg mb-6">
    <h3 class="text-xl font-semibold text-space-accent mb-4">Buildings</h3>
    <p class="text-gray-400 mb-4">Buildings: <%= @star_system.buildings.where(status: ["operational", "under_construction"]).count %> / <%= @star_system.max_buildings %></p>
    
    <!-- Operational buildings -->
    <% operational_buildings = @star_system.buildings.where(status: "operational") %>
    <% if operational_buildings.any? %>
      <div class="mb-6">
        <h4 class="text-lg font-medium text-space-highlight mb-3">Operational Buildings</h4>
        <div class="grid gap-4 grid-cols-1 md:grid-cols-2">
          <% operational_buildings.each do |building| %>
            <div class="bg-space-blue/20 border border-space-purple/20 rounded-lg p-4">
              <div class="flex justify-between items-start">
                <h5 class="font-medium text-space-highlight"><%= building.building_type.name %> (Level <%= building.level %>)</h5>
                
                <!-- Simple CSS shape icon -->
                <div class="w-6 h-6 bg-space-highlight/30 rounded-lg"></div>
              </div>
              
              <p class="text-sm text-gray-300 mt-2"><%= building.building_type.description %></p>
              
              <% if building.current_effect(:tax_modifier) %>
                <p class="text-sm text-green-400 mt-2">Tax revenue: +<%= (building.current_effect(:tax_modifier) * 100).to_i %>%</p>
              <% end %>
              
              <!-- Status indicator -->
              <div class="mt-3 flex items-center justify-between">
                <div class="flex items-center">
                  <div class="w-2 h-2 bg-green-400 rounded-full mr-2"></div>
                  <span class="text-xs text-gray-400">Operational</span>
                </div>
                
                <%= button_to "Demolish", building_path(building), method: :delete, 
                    data: { turbo_confirm: "Are you sure you want to demolish this building? This will take 1 hour and resources will NOT be refunded." },
                    form_class: "inline",
                    class: "text-xs bg-red-900/50 hover:bg-red-900 text-red-300 px-2 py-1 rounded" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
    
    <!-- Buildings under construction -->
    <% under_construction = @star_system.buildings.where(status: "under_construction") %>
    <% if under_construction.any? %>
      <div class="mb-6">
        <h4 class="text-lg font-medium text-space-highlight mb-3">Buildings Under Construction</h4>
        <div class="grid gap-4 grid-cols-1 md:grid-cols-2">
          <% under_construction.each do |building| %>
            <div class="bg-space-blue/20 border border-space-purple/20 rounded-lg p-4">
              <div class="flex justify-between items-start">
                <h5 class="font-medium text-space-highlight"><%= building.building_type.name %> (Level <%= building.level %>)</h5>
                
                <!-- Simple CSS shape icon -->
                <div class="w-6 h-6 bg-space-highlight/30 rounded-lg"></div>
              </div>
              
              <p class="text-sm text-gray-300 mt-2"><%= building.building_type.description %></p>
              
              <!-- Progress bar -->
              <div class="relative pt-1 mt-3">
                <div class="text-xs text-space-highlight mb-1">Construction Progress: <%= building.construction_progress_percentage %>%</div>
                <div class="w-full bg-space-blue/20 rounded-full h-2.5">
                  <div class="bg-space-highlight h-2.5 rounded-full progress-bar" 
                       style="width: <%= building.construction_progress_percentage %>%"></div>
                </div>
              </div>
              
              <div class="text-xs text-gray-400 mt-2">
                Completes at: <%= building.construction_end.strftime("%B %d, %H:%M") %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
    
    <!-- Buildings being demolished -->
    <% being_demolished = @star_system.buildings.where(status: "being_demolished") %>
    <% if being_demolished.any? %>
      <div class="mb-6">
        <h4 class="text-lg font-medium text-space-highlight mb-3">Buildings Being Demolished</h4>
        <div class="grid gap-4 grid-cols-1 md:grid-cols-2">
          <% being_demolished.each do |building| %>
            <div class="bg-space-blue/20 border-red-800/40 border rounded-lg p-4 opacity-75">
              <div class="flex justify-between items-start">
                <h5 class="font-medium text-space-highlight"><%= building.building_type.name %> (Level <%= building.level %>)</h5>
                
                <!-- Simple CSS shape icon -->
                <div class="w-6 h-6 bg-red-900/30 rounded-lg"></div>
              </div>
              
              <!-- Progress bar -->
              <div class="relative pt-1 mt-3">
                <div class="text-xs text-red-400 mb-1">Demolition Progress: <%= building.demolition_progress_percentage %>%</div>
                <div class="w-full bg-space-blue/20 rounded-full h-2.5">
                  <div class="bg-red-600 h-2.5 rounded-full progress-bar" 
                       style="width: <%= building.demolition_progress_percentage %>%"></div>
                </div>
              </div>
              
              <div class="text-xs text-gray-400 mt-2">
                Completes at: <%= building.demolition_end.strftime("%B %d, %H:%M") %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
    
    <!-- Available buildings -->
    <div>
      <h4 class="text-lg font-medium text-space-highlight mb-3">Available Buildings</h4>
      <div class="grid gap-4 grid-cols-1 md:grid-cols-2">
        <% BuildingType.all.each do |building_type| %>
          <div class="bg-space-blue/20 border border-space-purple/20 rounded-lg p-4">
            <div class="flex justify-between items-start">
              <h5 class="font-medium text-space-highlight"><%= building_type.name %></h5>
              
              <!-- Simple CSS shape icon -->
              <div class="w-6 h-6 bg-space-highlight/30 rounded-lg"></div>
            </div>
            
            <p class="text-sm text-gray-300 mt-2"><%= building_type.description %></p>
            
            <div class="text-xs text-gray-400 mt-2">
              Cost: <%= building_type.cost_for_level(1)["credits"] %> Credits, 
              <%= building_type.cost_for_level(1)["minerals"] %> Minerals, 
              <%= building_type.cost_for_level(1)["energy"] %> Energy
            </div>
            
            <div class="text-xs text-gray-400 mt-1">
              Construction time: <%= (building_type.construction_time_for_level(1) / 1.hour).round %> hours
            </div>
            
            <div class="mt-3">
              <% 
                can_build = true
                error_message = nil
                
                # Check if we're at max buildings
                if @star_system.buildings.where(status: ["operational", "under_construction"]).count >= @star_system.max_buildings
                  can_build = false
                  error_message = "Maximum buildings reached"
                end
                
                # Check if unique building already exists
                if building_type.unique_per_system && @star_system.buildings.where(building_type: building_type).exists?
                  can_build = false
                  error_message = "Already built"
                end
                
                # Check resources
                cost = building_type.cost_for_level(1)
                empire = current_user.empire
                
                if empire.credits < cost["credits"] || empire.minerals < cost["minerals"] || empire.energy < cost["energy"]
                  can_build = false
                  error_message = "Insufficient resources"
                end
              %>
              
              <% if can_build %>
                <%= form_with(model: Building.new, local: true) do |form| %>
                  <%= form.hidden_field :building_type_id, value: building_type.id %>
                  <%= form.hidden_field :star_system_id, value: @star_system.id %>
                  
                  <button type="button" 
                          onclick="openBuildModal('<%= building_type.name %>', <%= cost["credits"] %>, <%= cost["minerals"] %>, <%= cost["energy"] %>, <%= building_type.id %>)"
                          class="w-full bg-space-nebula hover:bg-space-purple text-white text-sm font-medium py-2 px-4 rounded-lg transition">
                    Build
                  </button>
                  
                  <!-- Hidden submit button that will be triggered by the modal -->
                  <%= form.submit "Confirm Construction", 
                      id: "confirm-build-#{building_type.id}",
                      style: "display: none;",
                      class: "w-full bg-space-nebula hover:bg-space-purple text-white text-sm font-medium py-2 px-4 rounded-lg transition" %>
                <% end %>
              <% else %>
                <button disabled class="w-full bg-space-blue/40 text-gray-500 text-sm font-medium py-2 px-4 rounded-lg cursor-not-allowed">
                  <%= error_message %>
                </button>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Building Construction Confirmation Modal -->
<div id="buildModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center">
  <div class="bg-space-blue/90 border border-space-purple/50 rounded-lg p-6 max-w-md w-full mx-4">
    <h3 class="text-xl font-semibold text-space-accent mb-4">Confirm Building Construction</h3>
    
    <div class="mb-4">
      <p class="text-gray-300 mb-2">Are you sure you want to construct a <span id="modalBuildingName" class="text-space-highlight"></span>?</p>
      <p class="text-gray-300">This will cost:</p>
      <ul class="text-space-highlight ml-4 mt-1">
        <li><span id="modalCredits"></span> Credits</li>
        <li><span id="modalMinerals"></span> Minerals</li>
        <li><span id="modalEnergy"></span> Energy</li>
      </ul>
    </div>
    
    <div class="flex justify-end space-x-3">
      <button type="button" 
              onclick="closeBuildModal()" 
              class="bg-transparent border border-space-purple/50 text-space-highlight hover:bg-space-blue/30 py-2 px-4 rounded-lg transition">
        Cancel
      </button>
      <button type="button" 
              onclick="confirmBuild()" 
              class="bg-space-nebula hover:bg-space-purple text-white font-medium py-2 px-4 rounded-lg transition">
        Confirm Construction
      </button>
    </div>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
  // Hide all confirm-build submit buttons if JS is enabled
  document.querySelectorAll('input[type="submit"][id^="confirm-build-"]').forEach(function(btn) {
    btn.style.display = "none";
  });
});

function openBuildModal(buildingName, credits, minerals, energy, buildingTypeId) {
  document.getElementById('modalBuildingName').textContent = buildingName;
  document.getElementById('modalCredits').textContent = credits;
  document.getElementById('modalMinerals').textContent = minerals;
  document.getElementById('modalEnergy').textContent = energy;
  document.getElementById('buildModal').classList.remove('hidden');
  // Show only the relevant submit button
  document.querySelectorAll('input[type="submit"][id^="confirm-build-"]').forEach(function(btn) {
    btn.style.display = "none";
  });
  var btn = document.getElementById('confirm-build-' + buildingTypeId);
  if (btn) btn.style.display = "block";
}

function closeBuildModal() {
  document.getElementById('buildModal').classList.add('hidden');
  // Hide all confirm-build submit buttons again
  document.querySelectorAll('input[type="submit"][id^="confirm-build-"]').forEach(function(btn) {
    btn.style.display = "none";
  });
}

function confirmBuild() {
  // Find the visible submit button and click it
  const submitButton = document.querySelector('input[type="submit"][id^="confirm-build-"]:not([style*="display: none"])');
  if (submitButton) {
    submitButton.click();
  }
  closeBuildModal();
}

// Close modal when clicking outside of it
document.getElementById('buildModal').addEventListener('click', function(e) {
  if (e.target === this) {
    closeBuildModal();
  }
});
</script>
